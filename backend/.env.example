[TEMPLATE]
[TEMPLATE]
GROQ_API_KEY=your_groq_api_key_here

# --- Auth token signing ---
# Required in deployment: a long random secret (>= 32 bytes for HS256).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# If unset, the app generates an ephemeral key; issued logins then stop
# validating after every restart.
SECRET_KEY=replace_with_a_long_random_secret

# --- Embeddings (Cohere, cloud API) ---
# Required: embeddings are generated with Cohere's embed API (no local model
# memory). Create a free key at https://dashboard.cohere.com/api-keys
COHERE_API_KEY=your_cohere_api_key_here
# Optional: override the embed model (default: embed-english-v3.0, 1024-dim).
# COHERE_EMBED_MODEL=embed-english-v3.0

# LangSmith Tracing
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=studymate-dev

# Legacy LangChain environment variables (Fallback)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
# LANGCHAIN_API_KEY=your_langsmith_api_key_here
# LANGCHAIN_PROJECT=Studymate

# --- Database ---
# Leave UNSET for local development: the backend then uses SQLite
# (backend/chatbot.db), exactly as before — nothing local changes.
# Set it to your hosted Postgres URL for deployment (Render, Supabase, ...).
#
# Supabase: copy the "Session pooler" connection string from Project Settings →
# Database → Connection string. Do NOT use the direct db.<project-ref>.supabase.co
# host on Render's 512MB free tier — it resolves to IPv6, which Render cannot reach.
DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres
# If a local connection hangs or is refused, append the SSL requirement:
# DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres?sslmode=require

# --- Reranking (local torch cross-encoder, ~1.5GB resident) ---
# OFF by default: does not fit Render's 512MB free tier. Enable only where
# memory allows. Retrieval works without it via similarity scores alone.
# RERANKING_ENABLED=true
